# Google OAuth 2.0 Configuration for Chrome Extension
#
# IMPORTANT: This extension uses chrome.identity.getAuthToken() for OAuth
# No environment variables needed for OAuth!
#
# Setup steps:
# 1. Create "Chrome Extension" OAuth client in Google Cloud Console
# 2. Add client_id directly to manifest.json oauth2 section
# 3. No redirect URI configuration needed - Chrome handles it automatically!

# Debug mode (optional)
VITE_ENABLE_DEBUG_MODE=true

# Chrome Web Store publish API (used by CI/CD deploy-extension workflow)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_EXTENSION_ID=