{
  "manifest_version": 3,
  "name": "Calens",
  "version": "0.0.2.0",
  "key": "",
  "description": "Google Calendar analytics, better editing experience, and on-device privacy",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Calens"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://calendar.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "content/date-detector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "content/event-enhancer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "680969445571-0dcnmtjefms66l9g9g7pqf5396mu3p39.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}